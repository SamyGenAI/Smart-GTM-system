# Dependencies (install with npm install; the lockfile stays)
node_modules/

# Environment
.env
.env.*
*.env
!.env.example

# Credentials and secrets
credentials.json
*_credentials.*
*.pem
*.key

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Editor
.vscode/
.idea/
*.swp

# Sensitive outputs (never commit raw CRM data or contact lists)
outputs/lists/
outputs/raw/
outputs/gtm-pending/
*.csv

# Sync script live data outputs (contain metrics, not committed)
outputs/campaigns/**/results-sync.json
context/signal-performance-sync.json

# Personalized context files (user-specific, not for distribution)
# Templates (*-template.md) ARE tracked and pushed — only the filled-in versions are ignored
context/*/*.md
!context/*/*-template.md
# Watchlist and GTM settings are committed so routines can read them.
# They do not contain the offer or the ICP.
!context/signals/watchlist.md
!context/signals/gtm.md
